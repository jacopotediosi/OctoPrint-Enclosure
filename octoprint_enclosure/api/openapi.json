                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Outputs"
        ],
        "summary": "Control an output.",
        "description": "The attribute to send depends on the type of the output:\n\n- `on`: false turns any output off; true turns on only an output that is only on or off.\n- `duty_cycle`: for a PWM output.\n- `color`: for an output that shows a color.\n- `target`: for a thermostat; null turns it off.\n\nNeeds the \"Control outputs\" permission.",
        "operationId": "set_output",
        "security": [
          {
            "apiKey": [
              "PLUGIN_ENCLOSURE_OUTPUTS_CONTROL"
            ]
          }
        ],
        "parameters": [
          {
            "name": "output_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutputBody"
              },
              "examples": {
                "turn_a_relay_on": {
                  "summary": "Turn a relay on",
                  "value": {
                    "on": true
                  }
                },
                "turn_any_output_off": {
                  "summary": "Turn any output off",
                  "value": {
                    "on": false
                  }
                },
                "set_the_duty_cycle_of_a_pwm_output": {
                  "summary": "Set the duty cycle of a PWM output",
                  "value": {
                    "duty_cycle": 40
                  }
                },
                "set_the_color_of_a_led_strip": {
                  "summary": "Set the color of a LED strip",
                  "value": {
                    "color": "#ff8800"
                  }
                },
                "set_the_target_of_a_thermostat": {
                  "summary": "Set the target of a thermostat",
                  "value": {
                    "target": 30
                  }
                },
                "turn_a_thermostat_off": {
                  "summary": "Turn a thermostat off",
                  "value": {
                    "target": null
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An output, and its state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The user doesn't have the permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No output is set up with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "The Content-Type is not application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The body is not a JSON object, or its attributes are unknown, missing, not valid, or not valid for the type of the output.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
