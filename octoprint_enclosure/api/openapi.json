  "components": {
    "schemas": {
      "SensorInputResponse": {
        "type": "object",
        "description": "An input with a temperature sensor, and its last reading.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the item, unique among the items of its kind."
          },
          "type": {
            "type": "string",
            "enum": [
              "temperature_sensor"
            ],
            "description": "The type of the item."
          },
          "label": {
            "type": "string",
            "description": "The label given to the item."
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ],
            "examples": [
              21.5
            ],
            "description": "The temperature in Celsius, or null if the sensor has none."
          },
          "humidity": {
            "type": [
              "number",
              "null"
            ],
            "examples": [
              40.2
            ],
            "description": "The relative humidity in percent, or null if the sensor has none."
          },
          "air_quality": {
            "type": [
              "number",
              "null"
            ],
            "description": "The air quality index, or null if the sensor has none."
          }
        },
        "required": [
          "id",
          "type",
          "label",
          "temperature",
          "humidity",
          "air_quality"
        ]
      },
      "GpioInputResponse": {
        "type": "object",
        "description": "An input on a GPIO pin, and its state.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the item, unique among the items of its kind."
          },
          "type": {
            "type": "string",
            "enum": [
              "gpio"
            ],
            "description": "The type of the item."
          },
          "label": {
            "type": "string",
            "description": "The label given to the item."
          },
          "active": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the input is active, or null if its pin can't be read."
          }
        },
        "required": [
          "id",
          "type",
          "label",
          "active"
        ]
      },
      "InputResponse": {
        "description": "An input, and its state.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/SensorInputResponse"
          },
          {
            "$ref": "#/components/schemas/GpioInputResponse"
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Why a request failed.",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The problems found in the request, one message each."
          }
        },
        "required": [
          "errors"
        ]
      },
      "RegularOutputResponse": {
        "type": "object",
        "description": "An output that is only on or off, like a relay.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the item, unique among the items of its kind."
          },
          "type": {
            "type": "string",
            "enum": [
              "regular"
            ],
            "description": "The type of the item."
          },
          "label": {
            "type": "string",
            "description": "The label given to the item."
          },
          "on": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the output is on, or null if it can't be read."
          }
        },
        "required": [
          "id",
          "type",
          "label",
          "on"
        ]
      },
      "PwmOutputResponse": {
        "type": "object",
        "description": "A PWM output.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the item, unique among the items of its kind."
          },
          "type": {
            "type": "string",
            "enum": [
              "pwm"
            ],
            "description": "The type of the item."
          },
          "label": {
            "type": "string",
            "description": "The label given to the item."
          },
          "on": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the output is on, or null if it can't be read."
          },
          "duty_cycle": {
            "type": "number",
            "examples": [
              40
            ],
            "description": "The duty cycle, from 0 to 100."
          }
        },
        "required": [
          "id",
          "type",
          "label",
          "on",
          "duty_cycle"
        ]
      },
      "ColorOutputResponse": {
        "type": "object",
        "description": "An output that shows a color, like a LED strip.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id of the item, unique among the items of its kind."
          },
          "type": {
