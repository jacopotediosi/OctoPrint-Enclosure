<a href="#"
   title="{{ _('Raspberry Pi Outputs') }}"
   class="dropdown-toggle"
   data-toggle="dropdown"
   data-bind="visible: $root.navbarItems().length > 0 && $root.hasStatusPermission()">
    <i class="fa fa-codepen"></i>
    <b class="caret"></b>
</a>
<ul class="dropdown-menu" data-bind="foreach: $root.navbarItems()">
    <li data-bind="if: $root.navbarItemType($data) == 'regular', css: {disabled: !$root.hasOutputsControlPermission()}">
        <a href="#"
           data-bind="click: $root.hasOutputsControlPermission() ? $root.toggleOutput : function () {}">
            <span data-bind="text: label"></span>
            <span class="badge help-inline"
                  data-bind="text: on() ? '{{ _('on')|esq }}' : '{{ _('off')|esq }}', css: {'badge-success': on(), 'badge-important': !on()}"></span>
        </a>
    </li>
    <li data-bind="if: $root.navbarItemType($data) == 'gcode_output', css: {disabled: !$root.canSendGcode()}">
        <a href="#"
           data-bind="click: $root.canSendGcode() ? $root.runAction : function () {}">
            <span data-bind="text: label"></span>
            <span class="badge" data-bind="css: {'badge-info': $root.canSendGcode()}">gcode</span>
        </a>
    </li>
    <li data-bind="if: $root.navbarItemType($data) == 'shell_output', css: {disabled: !$root.hasActionsRunPermission()}">
        <a href="#"
           data-bind="click: $root.hasActionsRunPermission() ? $root.runAction : function () {}">
            <span data-bind="text: label"></span>
            <span class="badge"
                  data-bind="css: {'badge-info': $root.hasActionsRunPermission()}">shell</span>
        </a>
    </li>
    <li data-bind="if: $root.navbarItemType($data) == 'printer', css: {disabled: !$root.hasActionsRunPermission()}">
        <a href="#"
           data-bind="click: $root.hasActionsRunPermission() ? $root.runAction : function () {}">
            <span data-bind="text: label"></span>
            <span class="badge"
                  data-bind="css: {'badge-info': $root.hasActionsRunPermission()}">{{ _("printer") }}</span>
        </a>
    </li>
</ul>
