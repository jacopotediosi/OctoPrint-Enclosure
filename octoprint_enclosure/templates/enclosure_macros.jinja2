{% macro text_control_group(value_binding, label, help="", disabled=false) %}
    <div class="control-group">
        <label class="control-label">{{ label }}</label>
        <div class="controls">
            <input type="text"
                   class="input-block-level"
                   data-bind="value: {{ value_binding }}"
                   {% if disabled %}disabled{% endif %}>
            {% if help %}<span class="help-inline">{{ help }}</span>{% endif %}
            {% if caller is defined %}{{ caller() }}{% endif %}
        </div>
    </div>
{% endmacro %}
{% macro temperature_control_group(value_binding, label, help="", interval=false, zero_off=false) %}
    <div class="control-group">
        <label class="control-label">{{ label }}</label>
        <div class="controls">
            <div class="input-append">
                <input type="text"
                       class="input-medium"
                       data-bind="temperature: {{ value_binding }}{% if interval %}, temperatureInterval: true{% endif %}{% if zero_off %}, temperatureZeroOff: true{% endif %}">
                <span class="add-on" data-bind="text: $root.temperatureUnitLabel()"></span>
            </div>
            {% if help %}<span class="help-inline">{{ help }}</span>{% endif %}
        </div>
    </div>
{% endmacro %}
{% macro select_control_group(value_binding, label, options, help="", placeholder="") %}
    <div class="control-group">
        <label class="control-label">{{ label }}</label>
        <div class="controls">
            <select data-bind="{% if options is string %}options: {{ options }}, optionsText: 'label', optionsValue: 'index_id', {% if placeholder %}optionsCaption: '{{ placeholder }}', optionsAfterRender: $root.disablePlaceholderOption, {% endif %}{% endif %}value: {{ value_binding }}{% if placeholder %}, valueAllowUnset: true, placeholderWhenUnset: true{% endif %}">
                {% if options is not string %}
                    {% if placeholder %}<option value="" disabled>{{ placeholder }}</option>{% endif %}
                    {% for value, text in options %}<option value="{{ value }}">{{ text }}</option>{% endfor %}
                {% endif %}
            </select>
            {% if help %}<span class="help-inline">{{ help }}</span>{% endif %}
            {% if caller is defined %}{{ caller() }}{% endif %}
        </div>
    </div>
{% endmacro %}
{% macro checkbox_control_group(checked_binding, label, help="") %}
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: {{ checked_binding }}">
                {{ label }}
            </label>
            {% if help %}<span class="help-inline">{{ help }}</span>{% endif %}
            {% if caller is defined %}{{ caller() }}{% endif %}
        </div>
    </div>
{% endmacro %}
{% macro gpio_alert(development_mode, gpio_import_error, gpio_numbering_is_board) %}
    {% if development_mode %}
        <div class="alert alert-error enclosure-gpio-alert">
            <strong>{{ _("Development mode is enabled:") }}</strong> {{ _("GPIO and I2C (pins, sensors, etc) are simulated.") }}
        </div>
    {% elif gpio_import_error %}
        <div class="alert alert-error enclosure-gpio-alert">
            <strong>{{ _("The GPIO library failed to load:") }}</strong> {{ gpio_import_error }}
            <br>
            {{ _("This usually happens when OctoPrint isn't running on a Raspberry Pi. GPIO (pins, sensors, etc) won't work.") }}
        </div>
    {% elif gpio_numbering_is_board %}
        <div class="alert alert-error enclosure-gpio-alert">
            <strong>{{ _("Another plugin set the GPIO numbering to BOARD:") }}</strong> {{ _("this plugin needs BCM, so its GPIO pins won't work.") }}
        </div>
    {% endif %}
{% endmacro %}
{% macro setpoint_control_groups(output_binding) %}
    <div data-bind="if: $root.outputType({{ output_binding }}()) == 'pwm'">
        {{ text_control_group("duty_cycle", _("Duty Cycle"), "Duty cycle the PWM is set to when the automation turns it on, between 0 and 100") }}
    </div>
    <div data-bind="if: ['ledstrip', 'neopixel_indirect', 'neopixel_direct'].indexOf($root.outputType({{ output_binding }}())) >= 0">
        <div class="control-group">
            <label class="control-label">{{ _("Color") }}</label>
            <div class="controls">
                <input type="color" class="input-block-level" data-bind="value: color">
                <span class="help-inline">Color the LEDs are set to when the automation turns them on</span>
            </div>
        </div>
    </div>
    <div data-bind="if: $root.outputType({{ output_binding }}()) == 'temp_hum_control'">
        <div data-bind="if: $root.thermostatDeviceType({{ output_binding }}()) == 'dehumidifier'">
            {{ text_control_group("target", _("Target"), "Humidity the thermostat is set to when the automation turns it on") }}
        </div>
        <div data-bind="ifnot: $root.thermostatDeviceType({{ output_binding }}()) == 'dehumidifier'">
            {{ temperature_control_group("target", _("Target"), "Temperature the thermostat is set to when the automation turns it on", zero_off=true) }}
        </div>
    </div>
{% endmacro %}
