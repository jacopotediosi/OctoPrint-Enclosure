{% from "enclosure_macros.jinja2" import gpio_alert %}
{{ gpio_alert(plugin_enclosure_development_mode, plugin_enclosure_gpio_import_error, plugin_enclosure_gpio_numbering_is_board) }}
<!-- <pre data-bind="text: ko.toJSON($root.rpi_outputs(), null, 2)"></pre> -->
<div class="row-fluid"
     data-bind="visible: $root.rpi_inputs_temperature_sensors().length > 0">
    <h4>Temperature</h4>
    <!-- <pre data-bind="text: ko.toJSON($root.rpi_inputs_temperature_sensors(), null, 2)"></pre> -->
    <table id="enclosure-table" class="table table-bordered table-hover">
        <thead>
            <tr>
                <th class="temperature_sensor"></th>
                <th class="temperature_actual"
                    title="{{ _('Current actual temperature as reported by your sensor') }}">{{ _("Temperature") }}</th>
                <th class="humidity_actual"
                    title="{{ _('Current humidity') }}"
                    data-bind="visible: $root.hasAnySensorWithHumidity()">{{ _("Humidity") }}</th>
                <th class="thermostat" data-bind="visible: $root.hasAnyThermostat()">{{ _("Thermostat") }}</th>
                <th class="temperature_target"
                    title="{{ _('Current target temperature') }}"
                    data-bind="visible: $root.hasAnyThermostat()">{{ _("Target") }}</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: $root.tab_temperature_table_rows()">
            <tr>
                <th class="temperature_sensor"
                    data-bind="visible: first, text: sensor.label, attr: {title: sensor.label, rowspan: rowspan}"></th>
                <td class="temperature_actual"
                    data-bind="visible: first, attr: {rowspan: rowspan}, with: sensor">
                    <span data-bind="text: $root.fromCelsius(temperature()), attr: {title: $root.fromCelsius(temperature())}"></span>
                    <span class="add-on" data-bind="text: $root.temperatureUnitLabel()"></span>
                </td>
                <td class="humidity_actual"
                    data-bind="visible: first && $root.humidityCapableSensor(sensor.temp_sensor_type()), attr: {rowspan: rowspan}, with: sensor">
                    <span data-bind="text: humidity, attr: {title: humidity}"></span>
                    <span class="add-on">%</span>
                </td>
                <td class="humidity_actual"
                    data-bind="visible: first && $root.hasAnySensorWithHumidity() && !$root.humidityCapableSensor(sensor.temp_sensor_type()), attr: {rowspan: rowspan}">N/A</td>
                <th class="thermostat"
                    data-bind="visible: $root.hasAnyThermostat(), text: thermostat && thermostat.label(), attr: {title: thermostat && thermostat.label()}">
                </th>
                <td class="temperature_target"
                    data-bind="visible: $root.hasAnyThermostat(), with: thermostat">
                    <form class="form-inline"
                          style="margin:0"
                          data-bind="submit: function(element) { $root.setTarget($data, element) }">
                        <div class="input-append">
                            <input type="number"
                                   min="0"
                                   max="999"
                                   class="input-mini input-nospin"
                                   data-bind="enable: $root.isUser(), value: new_target, valueUpdate: 'input', attr: {placeholder: $root.shownTarget($data)}">
                            <span class="add-on"
                                  data-bind="text: temp_ctr_type() == 'dehumidifier' ? '%' : $root.temperatureUnitLabel()"></span>
                        </div>
                        <div class="btn-group">
                            <button type="submit"
                                    data-bind="enable: $root.isUser()"
                                    class="btn btn-primary"
                                    title="{{ _('Set') }}">
                                <i class="fa fa-check"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-primary dropdown-toggle"
                                    data-toggle="dropdown"
                                    data-bind="enable: $root.isUser()">
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a href="#" data-bind="click: $root.turnOffThermostat">{{ _("Off") }}</a>
                                </li>
                            </ul>
                        </div>
                    </form>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div data-bind="foreach: $root.tab_outputs()">
    <div style="margin-bottom: 20px">
        <div data-bind="if: output_type() == 'regular'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">regular gpio</span>
                <span class="badge help-inline"
                      data-bind="text: on() ? 'on' : 'off', css: {'badge-success': on(), 'badge-important': !on()}"></span>
            </h4>
            <div>
                <button type="button"
                        data-bind="enable: $root.isUser(), click: $root.toggleOutput, text: on() ? 'Turn off' : 'Turn on'"
                        class="btn"></button>
            </div>
        </div>
        <div data-bind="if: output_type() == 'ledstrip'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">ledstrip</span>
            </h4>
            <div class="input-append ledstrip-div">
                <input type="color" class="input-block-level" data-bind="value: shown_color">
                <button type="submit"
                        class="btn btn-input-inc"
                        title="Set Color"
                        data-bind="enable: $root.isUser(), click: $root.setColor">
                    <i class="fa fa-check"></i>
                </button>
            </div>
        </div>
        <div data-bind="if: output_type() == 'pwm'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">pwm</span>
            </h4>
            <div class="input-append">
                <input type="text"
                       class="input-mini"
                       data-bind="value: new_duty_cycle, valueUpdate: 'input', attr: {placeholder: $root.shownDutyCycle(duty_cycle())}">
                <button type="button"
                        class="btn btn-input-inc"
                        data-bind="enable: $root.isUser() && !$root.isPwmLinked(index_id()), click: $root.setDutyCycle, attr: {title: $root.isPwmLinked(index_id()) ? 'Temperature controlled PWM' : 'Set PWM'}">
                    <i class="fa fa-check"></i>
                </button>
            </div>
        </div>
        <div data-bind="if: output_type() == 'neopixel_direct' || output_type() == 'neopixel_indirect'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">neopixel</span>
            </h4>
            <div class="input-append neopixel-div">
                <input type="color" class="input-block-level" data-bind="value: shown_color">
                <button type="submit"
                        class="btn btn-input-inc"
                        title="Set Color"
                        data-bind="enable: $root.isUser(), click: $root.setColor">
                    <i class="fa fa-check"></i>
                </button>
            </div>
        </div>
        <div data-bind="if: output_type() == 'temp_hum_control'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">thermostat</span>
                <span class="badge badge-warning"
                      data-bind="visible: temp_ctr_type() == 'heater'">Heater</span>
                <span class="badge badge-warning"
                      data-bind="visible: temp_ctr_type() == 'cooler'">Cooler</span>
                <span class="badge badge-warning"
                      data-bind="visible: temp_ctr_type() == 'dehumidifier'">Dehumidifier</span>
                <span class="badge help-inline"
                      data-bind="text: on() ? 'on' : 'off', css: {'badge-success': on(), 'badge-important': !on()}"></span>
            </h4>
        </div>
        <div data-bind="foreach: $root.automationsOn(index_id())">
            <h5>
                <span>Automation: <span data-bind="text: label"></span></span>
                <a href="#"
                   data-bind="visible: $root.isUser(), click: $root.switchAutomation, css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? 'Disable' : 'Enable'}"
                   class="fa enclosure-link"></a>
            </h5>
        </div>
        <span data-bind="visible: output_type() == 'temp_hum_control' && temp_ctr_type() == 'heater' && !$root.isTurnedOffAtPrintEnd(index_id())">
            <span class="label label-important">Warning:</span>
            <span> Nothing turns this
                <b>heater</b> off when the print ends: add an automation on PrintDone that turns it off, for safety.</span>
        </span>
    </div>
</div>
<div data-bind="foreach: $root.tab_actions()">
    <div style="margin-bottom: 20px">
        <div data-bind="if: action_type() == 'gcode_output'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">gcode output</span>
            </h4>
            <div>
                <button type="button"
                        data-bind="enable: $root.isOperational(), click: $root.runAction"
                        class="btn">Send gcode</button>
            </div>
        </div>
        <div data-bind="if: action_type() == 'shell_output'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">Shell Script</span>
            </h4>
            <div>
                <button type="button"
                        data-bind="enable: $root.isUser(), click: $root.runAction"
                        class="btn">Execute Script</button>
            </div>
        </div>
        <div data-bind="if: action_type() == 'printer'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">printer action</span>
            </h4>
            <div>
                <button type="button"
                        data-bind="enable: $root.isUser(), click: $root.runAction"
                        class="btn">Send command</button>
            </div>
        </div>
    </div>
</div>
<div data-bind="foreach: $root.tab_filament_sensors()">
    <h4>
        <span data-bind="text: label"></span>
        <span class="badge">filament sensor</span>
        <a href="#"
           data-bind="visible: $root.isUser(), click: $root.switchAutomation, css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? 'Disable Filament Sensor' : 'Enable Filament Sensor'}"
           class="fa enclosure-link"></a>
    </h4>
</div>
<div data-bind="foreach: $root.tab_automations()">
    <h4>
        <span data-bind="text: label"></span>
        <span class="badge">automation</span>
        <a href="#"
           data-bind="visible: $root.isUser(), click: $root.switchAutomation, css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? 'Disable' : 'Enable'}"
           class="fa enclosure-link"></a>
    </h4>
</div>
