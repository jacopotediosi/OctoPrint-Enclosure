{% from "enclosure_macros.jinja2" import gpio_alert %}
{{ gpio_alert(plugin_enclosure_development_mode, plugin_enclosure_gpio_import_error, plugin_enclosure_gpio_numbering_is_board) }}
<div id="enclosure-invalid-settings-alert"
     class="alert alert-error"
     data-bind="visible: invalidSettingsItemNames().length">
    <strong>{{ _("Some items have invalid settings and don't work:") }}</strong>
    <span data-bind="text: invalidSettingsItemNames().join(', ')"></span>.
    {{ _("Open the settings to see why.") }}
</div>
<!-- <pre data-bind="text: ko.toJSON($root.rpi_outputs(), null, 2)"></pre> -->
<div class="row-fluid"
     data-bind="visible: $root.temperatureSensors().length > 0">
    <h4>{{ _("Temperature") }}</h4>
    <!-- <pre data-bind="text: ko.toJSON($root.temperatureSensors(), null, 2)"></pre> -->
    <table id="enclosure-table" class="table table-bordered table-hover">
        <thead>
            <tr>
                <th class="temperature_sensor"></th>
                <th class="temperature_actual"
                    title="{{ _('Current actual temperature as reported by your sensor') }}">{{ _("Temperature") }}</th>
                <th class="humidity_actual"
                    title="{{ _('Current humidity') }}"
                    data-bind="visible: $root.hasAnySensorWithHumidity()">{{ _("Humidity") }}</th>
                <th class="thermostat" data-bind="visible: $root.hasAnyThermostat()">{{ _("Thermostat") }}</th>
                <th class="temperature_target"
                    title="{{ _('Current target temperature') }}"
                    data-bind="visible: $root.hasAnyThermostat()">{{ _("Target") }}</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: $root.tabTemperatureTableRows()">
            <tr>
                <th class="temperature_sensor"
                    data-bind="visible: first, text: sensor.label, attr: {title: sensor.label, rowspan: rowspan}"></th>
                <td class="temperature_actual"
                    data-bind="visible: first, attr: {rowspan: rowspan}, with: sensor">
                    <span data-bind="text: $root.fromCelsius(temperature()), attr: {title: $root.fromCelsius(temperature())}"></span>
                    <span class="add-on" data-bind="text: $root.temperatureUnitSymbol()"></span>
                </td>
                <td class="humidity_actual"
                    data-bind="visible: first && $root.measuresHumidity(sensor.temp_sensor_type()), attr: {rowspan: rowspan}, with: sensor">
                    <span data-bind="text: humidity, attr: {title: humidity}"></span>
                    <span class="add-on">%</span>
                </td>
                <td class="humidity_actual"
                    data-bind="visible: first && $root.hasAnySensorWithHumidity() && !$root.measuresHumidity(sensor.temp_sensor_type()), attr: {rowspan: rowspan}">{{ _("N/A") }}</td>
                <th class="thermostat"
                    data-bind="visible: $root.hasAnyThermostat(), text: thermostat && thermostat.label(), attr: {title: thermostat && thermostat.label()}">
                </th>
                <td class="temperature_target"
                    data-bind="visible: $root.hasAnyThermostat(), with: thermostat">
                    <form class="form-inline"
                          style="margin:0"
                          data-bind="submit: function(element) { $root.setTarget($data, element) }">
                        <div class="input-append">
                            <input type="number"
                                   min="0"
                                   max="999"
                                   class="input-mini input-nospin"
                                   data-bind="enable: $root.hasOutputsControlPermission() && measurement() !== null, value: typed_target, valueUpdate: 'input', attr: {placeholder: $root.shownTarget($data)}">
                            <span class="add-on"
                                  data-bind="text: $root.measurementSymbol(measurement())"></span>
                        </div>
                        <div class="btn-group">
                            <button type="submit"
                                    data-bind="enable: $root.hasOutputsControlPermission() && measurement() !== null && typed_target() !== ''"
                                    class="btn btn-primary"
                                    title="{{ _('Set') }}">
                                <i class="fa fa-check"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-primary dropdown-toggle"
                                    data-toggle="dropdown"
                                    data-bind="enable: $root.hasOutputsControlPermission()">
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a href="#" data-bind="click: $root.turnOffThermostat">{{ _("Off") }}</a>
                                </li>
                            </ul>
                        </div>
                    </form>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div data-bind="foreach: $root.tabOutputs()">
    <div style="margin-bottom: 20px">
        <div data-bind="if: output_type() == 'regular'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">{{ _("regular gpio") }}</span>
                <span class="badge help-inline"
                      data-bind="text: on() ? '{{ _('on')|esq }}' : '{{ _('off')|esq }}', css: {'badge-success': on(), 'badge-important': !on()}"></span>
            </h4>
            <div>
                <button type="button"
                        data-bind="enable: $root.hasOutputsControlPermission(), click: $root.toggleOutput, text: on() ? '{{ _('Turn off')|esq }}' : '{{ _('Turn on')|esq }}'"
                        class="btn"></button>
            </div>
        </div>
        <div data-bind="if: output_type() == 'ledstrip'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">{{ _("ledstrip") }}</span>
            </h4>
            <div class="input-append enclosure-color-picker">
                <input type="color"
                       class="input-block-level"
                       data-bind="enable: $root.hasOutputsControlPermission(), value: shown_color">
                <button type="submit"
                        class="btn btn-input-inc"
                        title="{{ _('Set Color') }}"
                        data-bind="enable: $root.hasOutputsControlPermission(), click: $root.setColor">
                    <i class="fa fa-check"></i>
                </button>
            </div>
        </div>
        <div data-bind="if: output_type() == 'pwm'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">pwm</span>
            </h4>
            <div class="input-append">
                <input type="number"
                       min="0"
                       max="100"
                       step="1"
                       class="input-mini input-nospin"
                       data-bind="enable: $root.hasOutputsControlPermission(), value: typed_duty_cycle, valueUpdate: 'input', attr: {placeholder: $root.shownDutyCycle(duty_cycle())}">
                <button type="button"
                        class="btn btn-input-inc"
                        data-bind="enable: $root.hasOutputsControlPermission() && !$root.hasActiveTemperatureCurve(index_id()) && typed_duty_cycle() !== '', click: $root.setDutyCycle, attr: {title: $root.hasActiveTemperatureCurve(index_id()) ? '{{ _('Temperature controlled PWM')|esq }}' : '{{ _('Set PWM')|esq }}'}">
                    <i class="fa fa-check"></i>
                </button>
            </div>
        </div>
        <div data-bind="if: output_type() == 'neopixel_direct' || output_type() == 'neopixel_indirect'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">neopixel</span>
            </h4>
            <div class="input-append enclosure-color-picker">
                <input type="color"
                       class="input-block-level"
                       data-bind="enable: $root.hasOutputsControlPermission(), value: shown_color">
                <button type="submit"
                        class="btn btn-input-inc"
                        title="{{ _('Set Color') }}"
                        data-bind="enable: $root.hasOutputsControlPermission(), click: $root.setColor">
                    <i class="fa fa-check"></i>
                </button>
            </div>
        </div>
        <div data-bind="if: output_type() == 'temp_hum_control'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">{{ _("thermostat") }}</span>
                <span class="badge badge-warning"
                      data-bind="visible: temp_ctr_type() == 'heater'">{{ _("Heater") }}</span>
                <span class="badge badge-warning"
                      data-bind="visible: temp_ctr_type() == 'cooler'">{{ _("Cooler") }}</span>
                <span class="badge badge-warning"
                      data-bind="visible: temp_ctr_type() == 'dehumidifier'">{{ _("Dehumidifier") }}</span>
                <span class="badge help-inline"
                      data-bind="text: on() ? '{{ _('on')|esq }}' : '{{ _('off')|esq }}', css: {'badge-success': on(), 'badge-important': !on()}"></span>
            </h4>
        </div>
        <div data-bind="foreach: $root.tabAutomationsOfOutput(index_id())">
            <h5>
                <span>{{ _("Automation:") }} <span data-bind="text: label"></span></span>
                <a href="#"
                   data-bind="visible: $root.hasAutomationsEnablePermission(), click: $root.toggleAutomation, css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? '{{ _('Disable')|esq }}' : '{{ _('Enable')|esq }}'}"
                   class="fa enclosure-link"></a>
                <span data-bind="visible: !$root.hasAutomationsEnablePermission(), css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? '{{ _('Enabled')|esq }}' : '{{ _('Disabled')|esq }}'}"
                      class="fa muted"></span>
            </h5>
        </div>
        <span data-bind="visible: output_type() == 'temp_hum_control' && temp_ctr_type() == 'heater' && !$root.isTurnedOffAtPrintEnd(index_id())">
            <span class="label label-important">{{ _("Warning:") }}</span>
            <span>{{ _("Nothing turns this <b>heater</b> off when the print ends: add an automation on PrintDone that turns it off, for safety.") }}</span>
        </span>
    </div>
</div>
<div data-bind="foreach: $root.tabActions()">
    <div style="margin-bottom: 20px">
        <div data-bind="if: action_type() == 'gcode_output'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">{{ _("gcode output") }}</span>
            </h4>
            <div>
                <button type="button"
                        data-bind="enable: $root.canSendGcode(), click: $root.runAction"
                        class="btn">{{ _("Send gcode") }}</button>
            </div>
        </div>
        <div data-bind="if: action_type() == 'shell_output'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">{{ _("Shell Script") }}</span>
            </h4>
            <div>
                <button type="button"
                        data-bind="enable: $root.hasActionsRunPermission(), click: $root.runAction"
                        class="btn">{{ _("Execute Script") }}</button>
            </div>
        </div>
        <div data-bind="if: action_type() == 'printer'">
            <h4>
                <span data-bind="text: label"></span>
                <span class="badge">{{ _("printer action") }}</span>
            </h4>
            <div>
                <button type="button"
                        data-bind="enable: $root.hasActionsRunPermission(), click: $root.runAction"
                        class="btn">{{ _("Send command") }}</button>
            </div>
        </div>
    </div>
</div>
<div data-bind="foreach: $root.tabFilamentSensors()">
    <h4>
        <span data-bind="text: label"></span>
        <span class="badge">{{ _("filament sensor") }}</span>
        <a href="#"
           data-bind="visible: $root.hasAutomationsEnablePermission(), click: $root.toggleAutomation, css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? '{{ _('Disable Filament Sensor')|esq }}' : '{{ _('Enable Filament Sensor')|esq }}'}"
           class="fa enclosure-link"></a>
        <span data-bind="visible: !$root.hasAutomationsEnablePermission(), css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? '{{ _('Enabled')|esq }}' : '{{ _('Disabled')|esq }}'}"
              class="fa muted"></span>
    </h4>
</div>
<div data-bind="foreach: $root.tabAutomations()">
    <h4>
        <span data-bind="text: label"></span>
        <span class="badge">{{ _("automation") }}</span>
        <a href="#"
           data-bind="visible: $root.hasAutomationsEnablePermission(), click: $root.toggleAutomation, css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? '{{ _('Disable')|esq }}' : '{{ _('Enable')|esq }}'}"
           class="fa enclosure-link"></a>
        <span data-bind="visible: !$root.hasAutomationsEnablePermission(), css: {'fa-toggle-on': enabled(), 'fa-toggle-off': !enabled()}, attr: {title: enabled() ? '{{ _('Enabled')|esq }}' : '{{ _('Disabled')|esq }}'}"
              class="fa muted"></span>
    </h4>
</div>
